modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["libsodium"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord bot"

[[workflows.workflow]]
name = "Discord bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u main.py"

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
